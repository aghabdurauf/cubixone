# CubixOne settings. ./install.sh writes .env for you; this file documents it.

# Port on the host.
PORT=8080

# Signs sessions and encrypts stored database passwords and API keys.
# Generate once (openssl rand -hex 32) and never change it after setup.
SECRET_KEY=

# Where users, folders, permissions, connections, models and the audit log live.
#   built-in MySQL:  mysql+pymysql://cubix:<MYSQL_PASSWORD>@mysql:3306/cubixone?charset=utf8mb4
#   PostgreSQL:      postgresql+psycopg://user:pass@host:5432/dbname
#   SQL Server:      mssql+pymssql://user:pass@host:1433/dbname
#   MySQL/MariaDB:   mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
# (special characters in the password must be URL-encoded)
DATABASE_URL=

# "mysql" starts the built-in MySQL container; empty when using your own database.
COMPOSE_PROFILES=mysql
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# true once CubixOne is served over HTTPS (behind a reverse proxy or load balancer).
COOKIE_SECURE=false

# Which proxies may set X-Forwarded-For (the IP recorded in the audit log). * = any.
FORWARDED_ALLOW_IPS=*

# Optional: shared secret a live report service sends as X-Service-Key to /api/auth/check.
SERVICE_AUTH_KEY=
